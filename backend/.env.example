# Скопируй этот файл в .env и заполни реальными значениями.
# .env никогда не коммитится в git (см. .gitignore).

# Токен бота из @BotFather
BOT_TOKEN=

# Твой личный chat_id в Telegram — сюда будут падать уведомления о заказах.
# Как узнать: напиши /start своему боту, затем открой
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates и найди "chat":{"id": ...}
# (или просто напиши @userinfobot — он пришлёт твой id).
SELLER_CHAT_ID=

# Ключ авторизации GigaChat (Basic-ключ из личного кабинета Sber).
# Необязателен: если оставить пустым, магазин работает, а ИИ-чат отвечает «недоступен».
GIGACHAT_AUTH_KEY=

# ИИ-консультант через любой OpenAI-совместимый сервис (рекомендуем Google Gemini:
# бесплатный ключ на aistudio.google.com). Если LLM_API_KEY задан — используется он,
# иначе GigaChat (если есть ключ), иначе чат отвечает «временно недоступен».
LLM_API_KEY=
# Пусто = Gemini. Для Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Пусто = gemini-3-flash-preview, при сбое gemini-flash-latest. Можно перечислить несколько через запятую.
# Названия моделей у провайдеров устаревают — актуальные смотри в консоли.
LLM_MODEL=

# Публичный адрес бэкенда — тот же, что API_URL в index.html (сейчас это ngrok-ссылка).
# Без него кнопки «Оплата пришла» / «Отмена» под заказом работать не будут.
# Меняешь ngrok-ссылку — обнови и её тут, и API_URL в index.html, и перезапусти бэкенд.
PUBLIC_URL=
