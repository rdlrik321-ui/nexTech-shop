# Скопируй этот файл в .env и заполни реальными значениями.
# .env никогда не коммитится в git (см. .gitignore).

# Токен бота из @BotFather
BOT_TOKEN=

# Твой личный chat_id в Telegram — сюда будут падать уведомления о заказах.
# Как узнать: напиши /start своему боту, затем открой
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates и найди "chat":{"id": ...}
# (или просто напиши @userinfobot — он пришлёт твой id).
SELLER_CHAT_ID=

# Ключ авторизации GigaChat (Basic-ключ из личного кабинета Sber)
GIGACHAT_AUTH_KEY=
